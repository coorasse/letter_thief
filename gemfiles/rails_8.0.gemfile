source "https://rubygems.org"

gemspec path: ".."

gem "rails", "~> 8.0.0"
gem "minitest", "~> 5.0"

# ActiveSupport passes quirks_mode to JSON.generate, which json 3 removed
gem "json", "< 3"

gem "puma"
gem "propshaft"

gem "sqlite3"
gem "pg"
gem "mysql2"

gem "standard"

gem "launchy"

gem "faker"
